<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Universal Links: iOS opens https://hudhudnest.com/... in this app when
    https://hudhudnest.com/.well-known/apple-app-site-association lists this app's ID.
    The "Associated Domains" capability must also be enabled for the App ID in the Apple Developer
    portal. See docs/DEEP-LINKS.md.
  -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:hudhudnest.com</string>
  </array>
</dict>
</plist>
