diff --git a/tools/setup-ios.mjs b/tools/setup-ios.mjs
new file mode 100644
index 0000000..df19036
--- /dev/null
+++ b/tools/setup-ios.mjs
@@ -0,0 +1,52 @@
+import { execFileSync, spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+
+const root = process.cwd();
+const run = (command, args, options = {}) => {
+  console.log(`> ${command} ${args.join(' ')}`);
+  execFileSync(command, args, { cwd: root, stdio: 'inherit', ...options });
+};
+
+if (process.platform !== 'darwin') {
+  console.error('iOS native setup requires macOS with Xcode.');
+  console.error('Run "npm run ios:check" here, then execute "npm run ios:setup" on a Mac.');
+  process.exit(2);
+}
+
+for (const command of ['xcodebuild', 'pod']) {
+  const result = spawnSync('which', [command], { encoding: 'utf8' });
+  if (result.status !== 0) {
+    console.error(`Missing required command: ${command}`);
+    process.exit(3);
+  }
+}
+
+run('node', ['tools/validate-ios-config.mjs']);
+run('npm', ['install']);
+run('npm', ['run', 'build:prod']);
+
+const iosDir = path.join(root, 'ios');
+if (!fs.existsSync(iosDir)) run('npx', ['cap', 'add', 'ios']);
+run('npx', ['cap', 'sync', 'ios']);
+
+const plist = path.join(root, 'ios', 'App', 'App', 'Info.plist');
+if (fs.existsSync(plist)) {
+  const plistBuddy = '/usr/libexec/PlistBuddy';
+  const set = (key, type, value) => {
+    const current = spawnSync(plistBuddy, ['-c', `Print :${key}`, plist], { stdio: 'ignore' });
+    const action = current.status === 0 ? 'Set' : 'Add';
+    run(plistBuddy, ['-c', `${action} :${key} ${type} ${value}`, plist]);
+  };
+  set('CFBundleDisplayName', 'string', 'Real Estate World');
+  set('UIViewControllerBasedStatusBarAppearance', 'bool', 'true');
+}
+
+const privacySource = path.join(root, 'resources', 'ios', 'PrivacyInfo.xcprivacy');
+const privacyTarget = path.join(root, 'ios', 'App', 'App', 'PrivacyInfo.xcprivacy');
+if (fs.existsSync(privacySource)) fs.copyFileSync(privacySource, privacyTarget);
+
+run('npx', ['cap', 'sync', 'ios']);
+console.log('\nNative iOS platform generated and synchronized.');
+console.log('Next: npm run ios:open, select a Development Team, then build on a real device.');
diff --git a/tools/validate-ios-config.mjs b/tools/validate-ios-config.mjs
new file mode 100644
index 0000000..9de0a9d
--- /dev/null
+++ b/tools/validate-ios-config.mjs
@@ -0,0 +1,43 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+
+const root = process.cwd();
+const requiredFiles = ['package.json', 'angular.json', 'capacitor.config.ts'];
+const errors = [];
+const warnings = [];
+
+for (const file of requiredFiles) {
+  if (!fs.existsSync(path.join(root, file))) errors.push(`Missing required file: ${file}`);
+}
+
+const pkgPath = path.join(root, 'package.json');
+if (fs.existsSync(pkgPath)) {
+  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
+  const deps = { ...pkg.dependencies, ...pkg.devDependencies };
+  for (const dep of ['@capacitor/core', '@capacitor/cli', '@capacitor/ios']) {
+    if (!deps[dep]) errors.push(`Missing dependency: ${dep}`);
+  }
+  const majors = ['@capacitor/core', '@capacitor/cli', '@capacitor/ios']
+    .map((name) => String(deps[name] ?? '').match(/(\d+)/)?.[1])
+    .filter(Boolean);
+  if (new Set(majors).size > 1) errors.push('Capacitor core/cli/ios major versions do not match.');
+}
+
+const configPath = path.join(root, 'capacitor.config.ts');
+if (fs.existsSync(configPath)) {
+  const config = fs.readFileSync(configPath, 'utf8');
+  if (!/appId\s*:/.test(config)) errors.push('capacitor.config.ts has no appId.');
+  if (!/webDir\s*:/.test(config)) errors.push('capacitor.config.ts has no webDir.');
+  if (/cleartext\s*:\s*true/.test(config)) warnings.push('cleartext is permanently enabled; disable it for production.');
+}
+
+if (!fs.existsSync(path.join(root, 'ios'))) {
+  warnings.push('ios/ is not generated yet. Run npm run ios:setup on macOS.');
+}
+
+console.log('iOS configuration preflight');
+for (const warning of warnings) console.warn(`WARN: ${warning}`);
+for (const error of errors) console.error(`ERROR: ${error}`);
+if (errors.length) process.exit(1);
+console.log('PASS: static iOS configuration checks completed.');
