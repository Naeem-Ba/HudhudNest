<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="false"
      android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links: https://hudhudnest.com/... opens this app instead of the browser once Android has
              verified https://hudhudnest.com/.well-known/assetlinks.json against the app's signing certificate
              (autoVerify). The <data> list mirrors deep-links.config.json; tools/lib/deep-links.test.mjs fails
              if the two drift. Each allowed prefix is listed as the exact path plus "prefix/" so a link such as
              /onboarding never matches /o. /properties/edit is refused inside the app (deep-link-routes.ts)
              because a pathPrefix cannot express an exclusion. See docs/DEEP-LINKS.md.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hudhudnest.com" />
                <data android:path="/" />
                <data android:path="/properties" />
                <data android:pathPrefix="/properties/" />
                <data android:path="/short-stay" />
                <data android:pathPrefix="/short-stay/" />
                <data android:path="/investments" />
                <data android:pathPrefix="/investments/" />
                <data android:path="/users" />
                <data android:pathPrefix="/users/" />
                <data android:path="/offices" />
                <data android:pathPrefix="/offices/" />
                <data android:path="/o" />
                <data android:pathPrefix="/o/" />
                <data android:path="/agencies" />
                <data android:pathPrefix="/agencies/" />
                <data android:path="/wohnungen" />
                <data android:pathPrefix="/wohnungen/" />
                <data android:path="/kontakt" />
                <data android:pathPrefix="/kontakt/" />
                <data android:path="/valuation" />
                <data android:pathPrefix="/valuation/" />
                <data android:path="/pricing" />
                <data android:pathPrefix="/pricing/" />
            </intent-filter>

        </activity>

        <!--
          AdMob application ID (NOT an ad unit ID). The Mobile Ads SDK crashes the app at launch when this entry is
          missing, so it must exist even while ads are disabled. The value below is Google's official SAMPLE app ID
          and serves no real ads and earns nothing. Replace admob_app_id in res/values/strings.xml with the real ID
          from the owner's AdMob account only after the AdMob account is approved (docs/MONETIZATION.md).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Pushes without their own channel land here; the app creates the channel (push-registration.service.ts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hudhudnest_default" />

        <!--
          Google Play audit 2026-11-25 (H-01): ads are OFF in every build, so the AdMob SDK must not start itself or
          announce advertising capabilities. The SDK's auto-start provider is removed here; the app starts the SDK only
          through AdMobGateway.initialize(), which runs only when the ads layer is switched on at build time
          (docs/MONETIZATION.md). Before enabling Android ads: delete this block and the permission removals below,
          replace the sample AdMob app id, and update Data safety + the Ads/Advertising ID declarations in Play Console.
        -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- Advertising identifiers the AdMob library would merge in (ads are off, see the provider note above). -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
  <!-- No storage permissions on purpose: the PDF export is written to the app's own cache folder
       (native-file-export.gateway.ts, Directory.Cache) and photos come from the system picker. -->
</manifest>
