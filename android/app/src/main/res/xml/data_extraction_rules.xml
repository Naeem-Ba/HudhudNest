<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). The app keeps nothing worth restoring on another device, and its WebView storage holds the
  refresh-token cookie and session data: restoring those onto a new phone would carry a signed-in session across
  devices. So nothing is backed up to the cloud or copied in a device-to-device transfer. The user signs in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
